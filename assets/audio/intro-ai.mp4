.emoji-keyboard-variant__wrapper { border-radius: 30px; box-sizing: content-box; display: grid; grid-template-columns: repeat(6, fit-content(38px)); gap: 5px; padding: 11px 15px; }

.emoji-keyboard-variant__emoji { font-family: "Noto Color Emoji", "Adobe Blank"; font-size: 25px; border-radius: 10px; cursor: pointer; height: 38px; width: 38px; }

