:where(:root):root .xap-inline-dialog-container .xap-dialog-layout .xap-dialog-layout-content { max-height: none; }

@media (forced-colors: active) {
  :where(:root):root .xap-inline-dialog-container { outline-style: solid; outline-width: 2px; outline-color: var(--xap-color-outline,black); }
  :where(:root):root .xap-inline-dialog-container:focus { outline: dashed 3px; }
}

