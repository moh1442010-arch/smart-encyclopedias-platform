:where(:root):root { --mat-focus-indicator-border-color: var(--nlm-strong-focus-indicator); --mat-focus-indicator-display: block; --mat-focus-indicator-fallback-border-style: none; }

:where(:root):root .mat-mdc-standard-chip .mat-mdc-chip-action-label, :where(:root):root .mat-mdc-standard-chip .mdc-evolution-chip__action--primary, :where(:root):root .mat-mdc-standard-chip .mdc-evolution-chip__cell--primary { overflow: visible; }

:where(:root):root .xap-inline-dialog-container { box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgba(60, 64, 67, 0.15) 0px 1px 3px 1px; background: var(--xap-color-surface); color: var(--xap-color-on-surface); }

