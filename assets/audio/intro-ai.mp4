.drive-viewer-scrollable::-webkit-scrollbar-thumb:hover { background-color: rgb(159, 159, 159); box-shadow: rgb(204, 204, 204) -1px 1px 0px inset; }

.drive-viewer-v3 .drive-viewer-scrollable::-webkit-scrollbar-thumb:hover { background-color: rgba(255, 255, 255, 0.9); box-shadow: none; }

.drive-viewer-gm3.drive-viewer-v3 .drive-viewer-scrollable::-webkit-scrollbar-thumb:hover { background-color: var(--dt-outline-variant,rgb(218,220,224)); }

.drive-viewer-v3 .drive-viewer-scrollable.drive-viewer-scrollable-dark::-webkit-scrollbar-thumb:hover { background-color: rgb(159, 159, 159); }

.drive-viewer-gm3.drive-viewer-v3 .drive-viewer-scrollable::-webkit-scrollbar-thumb:hover { background-color: var(--dt-outline,rgb(128,134,139)); }

.drive-viewer-gm3.drive-viewer-v3 .drive-viewer-scrollable::-webkit-scrollbar-thumb:active { background-color: var(--dt-outline,rgb(128,134,139)); }

.drive-viewer-scrollable::-webkit-scrollbar-thumb { border-left: 1px solid transparent; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; box-shadow: rgb(103, 103, 103) -1px 1px 0px inset, rgb(103, 103, 103) 0px -1px 0px inset; }

.drive-viewer-scrollable::-webkit-scrollbar-thumb:hover { box-shadow: rgb(204, 204, 204) -1px 1px 0px inset; }

