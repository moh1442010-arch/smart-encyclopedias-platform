.drive-viewer-v3.drive-viewer-embed .drive-viewer-scrollable.drive-viewer-scrollable-highlight::-webkit-scrollbar-thumb { background-color: color-mix(in srgb,var(--dt-shadow,#000) 60%,transparent); }

