.drive-viewer-v3 .drive-viewer-scrollable::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.75); border-radius: 1px; border-width: 0px; box-shadow: none; min-height: 56px; padding: 0px; }

.drive-viewer-gm3.drive-viewer-v3 .drive-viewer-scrollable::-webkit-scrollbar-thumb { background-color: var(--dt-outline-variant,rgb(218,220,224)); border-radius: 100px; border: 4px solid transparent; background-clip: padding-box; }

.drive-viewer-v3.drive-viewer-embed .drive-viewer-scrollable::-webkit-scrollbar-thumb { background-color: color-mix(in srgb,var(--dt-shadow,#000) 50%,transparent); }

