.drive-viewer-fixed-frame .goog-modalpopup-bg, .drive-viewer-fixed-frame .modal-dialog-bg { background-color: rgb(0, 0, 0); }

div.drive-viewer-dialog-bg { opacity: 0.75; }

.drive-viewer-dialog-title { background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); cursor: default; font-size: 16px; line-height: 24px; }

