.dark-theme .xap-inline-dialog-container { box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgba(60, 64, 67, 0.15) 0px 1px 3px 1px; background: var(--xap-color-surface); color: var(--xap-color-on-surface); }

