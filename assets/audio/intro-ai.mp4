.drive-viewer-gm3 .drive-viewer-dialog-buttons button:hover { background: color-mix(in srgb,var(--dt-primary,rgb(26,115,232)) 8%,transparent); color: var(--dt-primary,rgb(26,115,232)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.drive-viewer-gm3 .drive-viewer-dialog-buttons button:active, .drive-viewer-gm3 .drive-viewer-dialog-buttons button:focus { background: color-mix(in srgb,var(--dt-primary,rgb(26,115,232)) 12%,transparent); color: var(--dt-primary,rgb(26,115,232)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; box-shadow: none; }

.drive-viewer-dialog-buttons button:active { box-shadow: inset 0 1px 2px color-mix(in srgb,var(--dt-shadow,#000) 10%,transparent); }

.drive-viewer-dialog-buttons button:focus { border: 1px solid rgb(77, 144, 254); }

