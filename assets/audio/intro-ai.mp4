.emoji-keyboard__grid__icons { display: grid; grid-template-columns: repeat(9, 1fr); gap: 0px; }

.emoji-keyboard__grid__emoji-button { align-items: center; border-radius: 10px; cursor: pointer; display: inline-flex; height: 38px; justify-content: center; position: relative; text-align: center; vertical-align: middle; width: 38px; font-family: "Noto Color Emoji", "Adobe Blank"; font-size: 25px; }

