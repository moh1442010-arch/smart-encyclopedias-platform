.drive-viewer-dialog-buttons .drive-viewer-buttonset-action { background-color: rgb(26, 115, 232); background-image: -webkit-linear-gradient(top, rgb(77, 144, 254), rgb(71, 135, 237)); border: 1px solid rgb(48, 121, 237); color: rgb(255, 255, 255); }

.drive-viewer-dialog-buttons .drive-viewer-buttonset-action:active, .drive-viewer-dialog-buttons .drive-viewer-buttonset-action:hover { background-color: rgb(53, 122, 232); background-image: -webkit-linear-gradient(top, rgb(77, 144, 254), rgb(53, 122, 232)); border: 1px solid rgb(47, 91, 183); color: rgb(255, 255, 255); }

.drive-viewer-dialog-buttons .drive-viewer-buttonset-action:active { box-shadow: inset 0 1px 2px color-mix(in srgb,var(--dt-shadow,#000) 30%,transparent); }

