.drive-viewer { background-color: rgba(0, 0, 0, 0.85); inset: 0px; color: rgb(255, 255, 255); font-family: arial, sans-serif; overflow: clip; position: fixed; z-index: 1001; opacity: 0; transition-delay: 0s, 0.1s; transition-duration: 0.1s, 0s; transition-property: opacity, visibility; transition-timing-function: cubic-bezier(0, 0, 0.2, 1); visibility: hidden; -webkit-font-smoothing: antialiased; }

.drive-viewer.drive-viewer-embed { background-color: var(--gm3-sys-color-inverse-surface,#303030); }

.drive-viewer.drive-viewer-gm3 { background-color: color-mix(in srgb,var(--gm3-sys-color-surface-container,#f0f4f9) 92%,transparent); }

.drive-viewer.drive-viewer-transparent-scrim { background-color: transparent; }

.driveViewerDviRoot .drive-viewer.drive-viewer-gm3 { background-color: initial; }

.driveViewerWizUiViewerEl .drive-viewer { position: absolute; z-index: unset; }

.drive-viewer.drive-viewer-v3 { font-family: "Google Sans", Roboto, arial, sans-serif; }

.drive-viewer-shown { opacity: 1; transition-delay: 0s, 0s; transition-timing-function: cubic-bezier(0.4, 0, 1, 1); visibility: visible; }

.drive-viewer-banners { right: 0px; position: absolute; left: 0px; z-index: 20; }

.drive-viewer-fixed-frame { height: 100%; margin: 0px; width: 100%; overflow: hidden !important; }

.drive-viewer-focus-outlines-disabled :focus { outline: none; }

.appsDriveViewerClientProjectorContainer { height: 100%; position: relative; width: 100%; }

.appsDriveViewerClientIframe, .appsDriveViewerClientIframeContainer { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; height: 100%; position: absolute; top: 0px; width: 100%; z-index: 1001; }

.appsDriveViewerClientOverlay { inset: 0px; position: fixed; z-index: 1000; }

.appsDriveViewerClientLoadingScreen { align-items: center; display: flex; height: 100%; justify-content: center; position: absolute; top: 0px; width: 100%; z-index: 1000; }

.appsDriveViewerClientLoadingScreen .drive-viewer-msg-loading-text { display: none; }

.appsDriveViewerClientLoadingScreen .drive-viewer-msg-loading-img { height: 30px; width: 30px; }

.appsDriveViewerClientLoadingSpinnerContainer { align-items: center; display: flex; justify-content: center; width: 100%; }

.appsDriveViewerClientLegacyScrim, .appsDriveViewerClientScrimOverlay, .appsDriveViewerClientScrimStandalone { height: 100%; position: absolute; width: 100%; }

.appsDriveViewerClientLegacyScrim { background-color: color-mix(in srgb,var(--dt-shadow,#000) 85%,transparent); }

.appsDriveViewerClientScrimStandalone { background-color: var(--dt-surface-container-low,#fff); }

.appsDriveViewerClientScrimOverlay { background-color: color-mix(in srgb,var(--gm3-sys-color-scrim,#000) 92%,transparent); }

.appsDriveViewerClientCloseButtonContainer { right: 10px; position: absolute; top: 10px; z-index: 1002; }

.appsDriveViewerClientCloseButton { align-items: center; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; cursor: pointer; display: flex; justify-content: center; padding: 8px; }

.appsDriveViewerClientCloseButton:hover { background-color: color-mix(in srgb,var(--dt-surface,#fff) 8%,transparent); }

.appsDriveViewerClientErrorContainer { align-items: center; display: flex; height: 100%; justify-content: center; pointer-events: none; position: absolute; width: 100%; z-index: 1000; }

.appsDriveViewerClientErrorTextWrapper { background-color: rgb(76, 73, 76); border-radius: 12px; box-shadow: 0 10px 12px 5px color-mix(in srgb,var(--dt-shadow,#000) 20%,transparent); color: rgb(255, 255, 255); max-width: 90%; padding: 20px; pointer-events: auto; text-align: center; user-select: text; }

.appsDriveViewerClientErrorText { font-size: 19px; }

.appsDriveViewerClientStackTraceHeader { font-size: 17px; font-weight: 700; margin-top: 16px; text-align: right; }

.appsDriveViewerClientStackTraceContent { background-color: rgba(255, 255, 255, 0.1); border-radius: 4px; font-family: monospace; font-size: 12px; margin-top: 8px; max-height: 150px; overflow: auto; padding: 10px; text-align: right; white-space: pre-wrap; }

.appsDriveViewerClientHidden { display: none; }

.appsDriveViewerClientScrollLock { height: 100%; margin: 0px; width: 100%; overflow: hidden !important; }

.drive-spinner { height: 44px; overflow: hidden; position: relative; }

.drive-quantum-spinner { height: 28px; right: 50%; margin-right: -14px; position: absolute; top: 8px; width: 28px; }

.drive-quantum-spinner.active { animation: 1568ms linear 0s infinite normal none running container-rotate; }

@keyframes container-rotate { 
  100% { transform: rotate(1turn); }
}

.spinner-layer { position: absolute; width: 100%; height: 100%; opacity: 0; }

.spinner-blue { border-color: rgb(66, 133, 244); }

.spinner-red { border-color: rgb(219, 68, 55); }

.spinner-yellow { border-color: rgb(244, 180, 0); }

.spinner-green { border-color: rgb(15, 157, 88); }

.drive-quantum-spinner.active .spinner-layer.spinner-blue { animation: 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running fill-unfill-rotate, 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running blue-fade-in-out; }

.drive-quantum-spinner.active .spinner-layer.spinner-red { animation: 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running fill-unfill-rotate, 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running red-fade-in-out; }

.drive-quantum-spinner.active .spinner-layer.spinner-yellow { animation: 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running fill-unfill-rotate, 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running yellow-fade-in-out; }

.drive-quantum-spinner.active .spinner-layer.spinner-green { animation: 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running fill-unfill-rotate, 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running green-fade-in-out; }

@keyframes fill-unfill-rotate { 
  12.5% { transform: rotate(135deg); }
  25% { transform: rotate(270deg); }
  37.5% { transform: rotate(405deg); }
  50% { transform: rotate(540deg); }
  62.5% { transform: rotate(675deg); }
  75% { transform: rotate(810deg); }
  87.5% { transform: rotate(945deg); }
  100% { transform: rotate(3turn); }
}

@keyframes blue-fade-in-out { 
  0% { opacity: 1; }
  25% { opacity: 1; }
  26% { opacity: 0; }
  89% { opacity: 0; }
  90% { opacity: 1; }
  100% { opacity: 1; }
}

@keyframes red-fade-in-out { 
  0% { opacity: 0; }
  15% { opacity: 0; }
  25% { opacity: 1; }
  50% { opacity: 1; }
  51% { opacity: 0; }
}

@keyframes yellow-fade-in-out { 
  0% { opacity: 0; }
  40% { opacity: 0; }
  50% { opacity: 1; }
  75% { opacity: 1; }
  76% { opacity: 0; }
}

@keyframes green-fade-in-out { 
  0% { opacity: 0; }
  65% { opacity: 0; }
  75% { opacity: 1; }
  90% { opacity: 1; }
  100% { opacity: 0; }
}

.spinner-gap-patch { position: absolute; box-sizing: border-box; top: 0px; left: 45%; width: 10%; height: 100%; overflow: hidden; border-color: inherit; }

.spinner-gap-patch .spinner-circle { width: 1000%; left: -450%; }

.spinner-circle-clipper { display: inline-block; position: relative; width: 50%; height: 100%; overflow: hidden; border-color: inherit; }

.spinner-circle-clipper .spinner-circle { width: 200%; }

.spinner-circle { box-sizing: border-box; height: 100%; border-width: 3px; border-style: solid; border-top-color: inherit; border-right-color: inherit; border-left-color: inherit; border-radius: 50%; animation: auto ease 0s 1 normal none running none; border-bottom-color: transparent !important; }

.spinner-circle-clipper.spinner-left .spinner-circle { border-right-color: transparent !important; transform: rotate(129deg); }

.spinner-circle-clipper.spinner-right .spinner-circle { left: -100%; transform: rotate(-129deg); border-left-color: transparent !important; }

.drive-quantum-spinner.active .spinner-circle-clipper.spinner-left .spinner-circle { animation: 1333ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running left-spin; }

.drive-quantum-spinner.active .spinner-circle-clipper.spinner-right .spinner-circle { animation: 1333ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running right-spin; }

@keyframes left-spin { 
  0% { transform: rotate(130deg); }
  50% { transform: rotate(-5deg); }
  100% { transform: rotate(130deg); }
}

@keyframes right-spin { 
  0% { transform: rotate(-130deg); }
  50% { transform: rotate(5deg); }
  100% { transform: rotate(-130deg); }
}

.spinner-fit { position: absolute; inset: 0px; }

