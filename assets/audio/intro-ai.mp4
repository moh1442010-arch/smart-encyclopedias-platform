.emoji-keyboard__container__diw { cursor: auto; height: 100%; position: relative; }

.emoji-keyboard__toolbar { height: 68px; z-index: 2; }

.emoji-keyboard__search { align-items: center; border-radius: 30px; display: flex; height: 28px; padding: 0px 10px; position: relative; }

.emoji-keyboard__search svg { display: block; margin-left: 6px; height: 20px; width: 20px; }

