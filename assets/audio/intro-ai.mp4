.emoji-keyboard__img { max-width: 100%; }

button .emoji-keyboard__img { pointer-events: none; }

.emoji-keyboard, .emoji-keyboard__background { height: 100%; right: 0px; position: fixed; top: 0px; width: 100%; z-index: 2147483647; }

