------MultipartBoundary--l95zqU9OIgd5cetaMjsRWJgHyLpNIrZEGbMRRVTWx0----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-ddabd6f7-8a43-4758-87d0-793d52a429fd@mhtml.blink

@charset "utf-8";

.boqHighlightVe [jslog] { box-shadow: rgb(127, 255, 212) 0px 0px 0px 5px; }

.glue-cookie-notification-bar { box-shadow: rgba(60, 64, 67, 0.3) 0px 2px 3px 0px, rgba(60, 64, 67, 0.15) 0px 6px 10px 4px; background: rgb(255, 255, 255); bottom: 0px; box-sizing: border-box; display: grid; font-size: 1rem; gap: 8px; grid-template-columns: auto auto; right: 0px; padding: 8px; position: fixed; width: 100%; z-index: 1000; }

.glue-cookie-notification-bar[aria-hidden="true"] { display: none; }

@media (min-width: 600px) {
  .glue-cookie-notification-bar { grid-template-columns: 1fr auto; justify-items: flex-end; }
}

@media (min-width: 1024px) {
  .glue-cookie-notification-bar { grid-template-columns: 1fr auto auto; }
}

@media (-ms-high-contrast:active), (forced-colors: active) {
  .glue-cookie-notification-bar { border-top: 1px solid transparent; }
}

@media print {
  .glue-cookie-notification-bar { display: none; }
}

.glue-cookie-notification-bar__text { font-family: "Google Sans Text", Roboto, Arial, Helvetica, sans-serif; }

