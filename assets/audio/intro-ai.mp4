.xap-emoji-keyboard .emoji-keyboard__categories { box-sizing: border-box; -webkit-box-align: center; align-items: center; display: flex; -webkit-box-flex: 1; flex: 1 0 auto; height: 40px; -webkit-box-pack: justify; justify-content: space-between; }

