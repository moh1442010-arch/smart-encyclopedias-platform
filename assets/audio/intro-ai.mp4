.sharekitUiCommonInternalProgressCircle { animation-duration: 1333ms; animation-fill-mode: both; animation-iteration-count: infinite; animation-name: expand-arc; animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); border-top-style: ; border-top-width: ; border-right-style: ; border-right-width: ; border-bottom-style: ; border-bottom-width: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-color: var(--ski-circular-progress-active-indicator-color) var(--ski-circular-progress-active-indicator-color) transparent transparent; border-radius: 50%; box-sizing: border-box; position: absolute; }

.sharekitUiCommonInternalProgressIndeterminate { animation: 1.56824s linear 0s infinite normal none running linear-rotate; }

.sharekitUiCommonInternalProgressLeft { inset: 0px 50% 0px 0px; overflow: hidden; position: absolute; }

.sharekitUiCommonInternalProgressLeft .sharekitUiCommonInternalProgressCircle { inset: 0px -100% 0px 0px; rotate: 135deg; }

.sharekitUiCommonInternalProgressProgress { align-items: center; contain: strict; content-visibility: auto; display: inline-flex; height: var(--ski-circular-progress-size); justify-content: center; position: relative; vertical-align: middle; width: var(--ski-circular-progress-size); }

.sharekitUiCommonInternalProgressProgressLayer { align-self: stretch; flex: 1 1 0%; inset: 0px; margin: 0.25rem; position: absolute; }

.sharekitUiCommonInternalProgressRight { inset: 0px 0px 0px 50%; overflow: hidden; position: absolute; }

.sharekitUiCommonInternalProgressRight .sharekitUiCommonInternalProgressCircle { animation-delay: -0.6665s, 0s; inset: 0px 0px 0px -100%; rotate: 100deg; }

.sharekitUiCommonInternalProgressSpinner { animation: 5332ms cubic-bezier(0.4, 0, 0.2, 1) 0s infinite normal both running rotate-arc; inset: 0px; position: absolute; }

@keyframes expand-arc { 
  0% { transform: rotate(265deg); }
  50% { transform: rotate(130deg); }
  100% { transform: rotate(265deg); }
}

@keyframes rotate-arc { 
  12.5% { transform: rotate(135deg); }
  25% { transform: rotate(270deg); }
  37.5% { transform: rotate(405deg); }
  50% { transform: rotate(540deg); }
  62.5% { transform: rotate(675deg); }
  75% { transform: rotate(810deg); }
  87.5% { transform: rotate(945deg); }
  100% { transform: rotate(3turn); }
}

@keyframes linear-rotate { 
