.drive-viewer-esignature-initials-field-unsigned, .drive-viewer-esignature-printed-name-field-unsigned, .drive-viewer-esignature-signature-field-unsigned { align-items: center; background: rgb(232, 240, 254); border: 1px solid rgb(24, 90, 188); border-radius: 4px; box-sizing: border-box; color: rgb(24, 90, 188); container-type: size; cursor: pointer; display: none; height: 100%; pointer-events: all; width: 100%; z-index: 2; }

.drive-viewer-esignature-custom-text-field-hidden-text, .drive-viewer-esignature-custom-text-field-unfilled { font-family: "Noto Sans"; font-style: normal; font-weight: 700; font-size: 12px; line-height: 22px; padding-right: 10px; padding-left: 10px; }

